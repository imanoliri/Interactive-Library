{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interactive-library.local/schema/library.schema.json",
  "title": "Interactive Library Knowledge Record",
  "type": "object",
  "required": ["id", "type"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "type": {
      "type": "string",
      "enum": ["universe", "series", "story", "chapter", "character", "location", "deity", "supernatural-being", "faction", "organization", "civilization", "creature", "species", "artifact", "event", "map", "fact", "decision", "summary", "research", "illustration-plan", "magic-system"]
    },
    "name": {"type": "string"},
    "universe_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "series_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "story_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "status": {
      "type": "string",
      "enum": ["draft", "proposed", "accepted", "rejected", "superseded", "published"]
    },
    "canon": {"type": "boolean"},
    "summary": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "references": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"},
        "uniqueItems": true
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "book_path": {"type": "string"},
        "google_drive": {"type": "string"},
        "generated": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
